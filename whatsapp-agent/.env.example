# =========================================================================
# CONFIGURACIÓN DEL AGENTE AUTÓNOMO DE WHATSAPP (META CLOUD API & GEMINI)
# =========================================================================

# Puerto del servidor local (Render o Railway lo asignan automáticamente en producción)
PORT=3000

# 1. CREDENCIALES DE META CLOUD API (Obtenidas en developers.facebook.com)
META_ACCESS_TOKEN=tu_token_de_acceso_permanente_o_temporal
META_PHONE_NUMBER_ID=tu_phone_number_id
META_WABA_ID=tu_whatsapp_business_account_id

# Token secreto inventado por ti para verificar el Webhook en Meta
# (Ejemplo: "mi_token_secreto_immunotec_2026")
META_VERIFY_TOKEN=mi_token_secreto_immunotec_2026

# 2. INTELIGENCIA ARTIFICIAL: GOOGLE GEMINI API
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.8-flash

# 3. NÚMERO DEL ASESOR HUMANO (Para alertas o transferencias si el cliente lo solicita)
HUMAN_ADVISOR_PHONE=5212227708716
